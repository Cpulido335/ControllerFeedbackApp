{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (MSYS2 GCC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/MyProgram", //gotta think of a better name than 'MyProgram'
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe", //we really need those VLAs 
            "preLaunchTask": "jah-build",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing"
                }
            ]
        }
    ]
}
